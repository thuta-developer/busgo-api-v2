# ============================================================
# BusGo — Root Environment Variables
# ============================================================
# ⚠️  ဒီ file က EXAMPLE ပါ။
# ⚠️  .env ဖိုင်မှာ real values ထည့်ပါ။
# ⚠️  .env ကို git commit မလုပ်ရ။
# ============================================================

# ---------- General ----------
ENVIRONMENT=development
DEBUG=True

# ---------- PostgreSQL ----------
POSTGRES_USER=busgo
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Databases (logical) ----------
IDENTITY_DB_NAME=identity_db
BUS_DB_NAME=bus_db
BOOKING_DB_NAME=booking_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT (RS256) ----------
# ⚠️  Production မှာ openssl နဲ့ ဖန်တီးပါ။
# Private key ကို Identity Service ပဲ သုံးရမယ်။
# Public key ကို FastAPI service တွေ သုံးမယ်။
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=busgo-identity
JWT_AUDIENCE=busgo-api
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Email ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@busgo.local

# ---------- SMS (later) ----------
SMS_PROVIDER=
SMS_API_KEY=

# ---------- Payment Providers (later) ----------
KBZ_PAY_API_KEY=
KBZ_PAY_SECRET=
AYA_PAY_API_KEY=
AYA_PAY_SECRET=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080